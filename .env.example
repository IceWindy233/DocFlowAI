DOCFLOW_ENV=development
DOCFLOW_POSTGRES_DB=docflow
DOCFLOW_POSTGRES_USER=docflow
DOCFLOW_POSTGRES_PASSWORD=docflow_dev_only
DOCFLOW_DATABASE_URL=postgresql+psycopg://docflow:docflow_dev_only@127.0.0.1:5432/docflow
DOCFLOW_REDIS_URL=redis://127.0.0.1:6379/0
DOCFLOW_QDRANT_URL=http://127.0.0.1:6333
DOCFLOW_ARTIFACT_ROOT=./data/artifacts
# 公开示例默认只允许浏览仓库内的虚构语料；按需改为你有权处理的数据目录。
DOCFLOW_SOURCE_ROOT=../examples
DOCFLOW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DOCFLOW_EXECUTION_MODE=celery

# 密钥只通过环境变量注入，配置中心只保存变量名称。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
